# Local Docker Postgres (pnpm db:up)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radar
# Prisma CLI URL. Local development can use the same direct database.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/radar
# Optional fallback name for a direct, non-pooler migration connection.
DIRECT_URL=
# Optional canonical public origin; never use a preview deployment hostname.
SITE_URL=https://remote-engineering-radar.vercel.app
# Optional: raises the GitHub API rate limit for FrontendBR and Quave ingestion.
GITHUB_TOKEN=
# Observability (leave empty locally; set in Vercel / GHA production-ingestion)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload source maps during CI/Vercel builds
SENTRY_AUTH_TOKEN=
# Server/edge/ingest CLI reads this first, so a rotated DSN applies without a rebuild.
SENTRY_DSN=
# Bearer token for POST /api/graphql (server-to-server). Unset rejects every request.
RADAR_API_TOKEN=
# Newsletter sending (confirmation mail and the daily digest). Required to send.
# Example for mail.remote-engineering-radar.me (SPEC-040):
# RESEND_FROM=Remote Engineering Radar <digest@mail.remote-engineering-radar.me>
# Leave RESEND_FROM unset in Vercel production so the public signup form stays
# hidden. Set it as a GitHub Actions variable on production-ingestion.
RESEND_API_KEY=
RESEND_FROM=
RESEND_SEGMENT_ID=
# Optional: members area origin; SiteHeader links to it only when set.
NEXT_PUBLIC_AREA_URL=
