# Local Docker Postgres (pnpm db:up)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radar
# Use a separately restricted role for production migrations.
DATABASE_MIGRATION_URL=
# Optional: raises the GitHub API rate limit for FrontendBR ingestion.
GITHUB_TOKEN=
GREENHOUSE_BOARD_TOKENS=
ASHBY_BOARD_NAMES=
# Observability (leave empty locally; set in Vercel for production)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload source maps during CI/Vercel builds
SENTRY_AUTH_TOKEN=
