# Local Docker Postgres (pnpm db:up)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radar
# Prisma CLI URL. Local development can use the same direct database.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/radar
# Optional fallback name for a direct, non-pooler migration connection.
DIRECT_URL=
# Optional: raises the GitHub API rate limit for FrontendBR ingestion.
GITHUB_TOKEN=
GREENHOUSE_BOARD_TOKENS=
ASHBY_BOARD_NAMES=
