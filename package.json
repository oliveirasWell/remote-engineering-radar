{
  "name": "remote-engineering-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ingest.ts",
    "db:generate": "prisma generate",
    "db:deploy": "tsx --env-file-if-exists=.env.local scripts/migrate-deploy.ts",
    "db:migrate": "pnpm db:deploy",
    "db:dev": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:status": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate status",
    "db:validate": "prisma validate",
    "db:baseline-check": "tsx --env-file-if-exists=.env.local scripts/migrate-deploy.ts --check-only",
    "db:resolve-baseline": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate resolve --applied 20260828000000_prisma_baseline",
    "db:smoke": "bash scripts/migration-smoke.sh",
    "db:up": "docker compose up -d --wait && pnpm db:deploy",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up",
    "deadcode": "knip",
    "circular": "madge --circular --extensions ts,tsx .",
    "boundaries": "bash scripts/check-boundaries.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:validate",
    "quality": "pnpm check && pnpm build && pnpm deadcode && pnpm circular && pnpm boundaries",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.1",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.18.11",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "madge": "8.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "prisma-pglite-bridge": "1.8.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
